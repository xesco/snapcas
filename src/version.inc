; The version of snapcas, MAJOR.MINOR (docs/BUILD.md, Version). MAJOR goes up
; when IMAGE_FORMAT changes, because then the images of an earlier version stop
; working. MINOR goes up at each other release. SNAPCAS.COM prints these lines
; when it starts, and snapcas.py --version reads them from this file.
        define VERSION "1.1"
        define YEAR "2026"
        define AUTHOR "Xesco"
